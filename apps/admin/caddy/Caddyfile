{
	servers {
		trusted_proxies static private_ranges
	}

	order rate_limit before file_server
}

:3000 {
	root * /usr/share/caddy/html

	# Per-client-IP rate limiting for static asset requests.
	# 10000/min = ~10 users behind one office NAT: each cold page load
	# fetches hundreds of JS chunks, so 300 (old default) returned 429.
	# If 429s persist under office NAT, switch to a composite key so each
	# logged-in session gets its own bucket:
	# key {client_ip}|{cookie.admin-session-id}
	# Anonymous traffic (no cookie) collapses to per-IP — acceptable.
	rate_limit {
		zone static {
			key {client_ip}
			events 10000
			window 1m
		}
	}

	# Security headers (HSTS is set at the TLS terminator)
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
	}

	# SPA fallback: the admin build is served from /god-mode
	try_files {path} /god-mode/index.html
	file_server

	# Access logs to stdout (default in Caddy)
	log {
		output stdout
		format console
	}
}
